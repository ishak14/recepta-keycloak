# Kopiera till .env. Allt här gäller bara lokal utveckling.
# Inga riktiga nycklar får stå i den här filen eller checkas in.

# Keycloaks databas (når bara inne i compose-nätet)
POSTGRES_PASSWORD=endast-lokalt-postgres-losenord

# Tillfälligt adminkonto för adminkonsolen, http://localhost:8082/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=endast-lokalt-admin-losenord

# Klienthemlighet för recepta-web i UTVECKLINGSLÄGE. Inte hemlig, får aldrig
# användas i drift. Sajten läser samma värde från KEYCLOAK_CLIENT_SECRET.
RECEPTA_WEB_CLIENT_SECRET=recepta-web-dev-endast-lokalt-ej-hemlig

# Sajtens adress: styr återanrop och adress efter utloggning i realmen.
RECEPTA_WEB_URL=http://localhost:3010

# Identitetsleverantören "bankid" (OIDC hos en återförsäljare). Platshållare
# tills ett avtal finns; leverantören är avstängd i realmen så länge.
BANKID_OIDC_ISSUER=https://bankid-platshallare.invalid
BANKID_OIDC_AUTHORIZATION_URL=https://bankid-platshallare.invalid/authorize
BANKID_OIDC_TOKEN_URL=https://bankid-platshallare.invalid/token
BANKID_OIDC_JWKS_URL=https://bankid-platshallare.invalid/jwks
BANKID_OIDC_CLIENT_ID=platshallare
BANKID_OIDC_CLIENT_SECRET=platshallare
# Namnet på det claim där återförsäljaren lämnar personnumret (skiljer mellan leverantörer).
BANKID_OIDC_CLAIM_PERSONAL_NUMBER=PLATSHALLARE
